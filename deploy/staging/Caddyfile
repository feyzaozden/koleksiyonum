test.koleksiyonum.com.tr {
    header {
        X-Robots-Tag "noindex, nofollow"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Cache-Control no-store
    }
    @health {
        method GET
        path /health /health/db
    }
    handle @health {
        reverse_proxy backend:3000
    }
    @auth {
        path /auth-test /auth-test.js /auth/register /auth/login /auth/logout /auth/session /auth/request-verification /auth/forgot-password /auth/verify-email /auth/reset-password
    }
    handle @auth {
        reverse_proxy backend:3000
    }
    @collection {
        path /collection-app /collection-app/* /collection-test /collection-test.js /api/collection /api/collection/*
    }
    handle @collection {
        reverse_proxy backend:3000
    }
    @home {
        method GET HEAD
        path /
    }
    handle @home {
        respond "Koleksiyonum test sunucusu hazir. Uygulama tasima islemleri devam ediyor." 200
    }
    handle {
        respond "Not found" 404
    }
}
